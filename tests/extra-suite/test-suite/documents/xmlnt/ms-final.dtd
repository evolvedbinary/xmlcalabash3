<!ENTITY % draft 'IGNORE' >
<!ENTITY % final 'INCLUDE' >

<![%draft;[
<!ELEMENT book (comments*, title, body)>
<!ATTLIST book status CDATA #IMPLIED>
<!ELEMENT comments (#PCDATA)*>
<!ENTITY status "DRAFT">
]]>
<![%final;[
<!ELEMENT book (title, body)>
<!ATTLIST book status CDATA #IMPLIED>
<!ENTITY status "FINAL">
]]>

<!ELEMENT title (#PCDATA)*>
<!ELEMENT body (p+)>
<!ELEMENT p (#PCDATA)*>
