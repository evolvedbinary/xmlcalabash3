default namespace = "https://xmlcalabash.com/ns/configuration"
namespace cc = "https://xmlcalabash.com/ns/configuration"

start = cc.xmlCalabash

cc.xmlCalabash =
    element cc:xml-calabash {
        attribute default-xquery-processor { xsd:anyURI }?,
        attribute licensed { xsd:boolean }?,
        attribute line-numbering { xsd:boolean }?,
        attribute piped-io { xsd:boolean }?,
        attribute saxon-configuration { text }?,
        attribute stacktrace { xsd:boolean }?,
        attribute try-namespaces { xsd:boolean }?,
        attribute use-location-hints { xsd:boolean }?,
        attribute validation-mode { "strict" | "lax" }?,
        attribute verbosity { "trace" | "debug" | "info" | "warn" | "error" }?,
        attribute version { "1.0" }?,
        (cc.catalog
        | cc.extension
        | cc.graphviz
        | cc.initializer
        | cc.inline
        | cc.mimetype
        | cc.namespace
        | cc.pagedMedia
        | cc.pipeline
        | cc.proxy
        | cc.saxonConfigurationProperty
        | cc.sendMail
        | cc.serialization
        | cc.systemProperty
        | cc.messageReporter
        | cc.visualizer
        | cc.threading
        | cc.xmlSchema
        | cc.xqueryProcessor
        | any-other-name)*
    }

cc.systemProperty =
    element cc:system-property {
        attribute name { text },
        attribute value { text },
        empty
    }

cc.proxy =
    element cc:proxy {
        attribute scheme { text },
        attribute uri { xsd:anyURI },
        empty
    }

cc.threading =
    element cc:threading {
        attribute count { xsd:integer }?,
        empty
    }

cc.initializer =
    element cc:initializer {
        attribute class { text },
        attribute ignore-errors { xsd:boolean }?,
        empty
    }

cc.inline =
    element cc:inline {
        attribute trim-whitespace { xsd:boolean },
        empty
    }

cc.extension =
    element cc:extension {
        attribute name { text },
        empty
    }

cc.graphviz =
    element cc:graphviz {
        attribute dot { text },
        attribute style { text }?,
        attribute output { text }?,
        empty
    }

cc.saxonConfigurationProperty =
    element cc:saxon-configuration-property {
        attribute name { text },
        attribute value { text },
        empty
    }

cc.serialization =
    element cc:serialization {
        attribute content-type { text },
        attribute * - content-type { text }*,

#        attribute method { text }?,
#        attribute allow-duplicate-names { xsd:boolean }?,
#        attribute build-tree { xsd:boolean }?,
#        attribute byte-order-mark { xsd:boolean }?,
#        attribute cdata-section-elements { text }?,
#        attribute doctype-public { text }?,
#        attribute doctype-system { text }?,
#        attribute encoding { text }?,
#        attribute escape-solidus { xsd:boolean }?,
#        attribute escape-uri-attributes { xsd:boolean }?,
#        attribute html-version { xsd:decimal }?,
#        attribute include-content-type { xsd:boolean }?,
#        attribute indent { xsd:boolean }?,
#        attribute item-separator { text }?,
#        attribute json-node-output-method { text }?,
#        attribute media-type { text }?,
#        attribute normalization-form { text }?,
#        attribute omit-xml-declaration { xsd:boolean }?,
#        attribute standalone { xsd:boolean | "omit" }?,
#        attribute suppress-indentation { text }?,
#        attribute undeclare-prefixes { xsd:boolean }?,
#        attribute version { text }?,
        empty
    }

cc.mimetype =
    element cc:mimetype {
        attribute content-type { text },
        attribute extensions { text },
        empty
    }

cc.pagedMedia =
    element cc:paged-media {
        attribute css-formatter { text }?,
        attribute xsl-formatter { text }?,
        attribute * - (css-formatter|xsl-formatter) { text }*,
        empty
    }

cc.sendMail =
    element cc:send-mail {
        attribute * { text }*,
        empty
    }

cc.messageReporter =
    element cc:message-reporter {
        attribute buffer-size { xsd:integer }?,
        empty
    }

cc.visualizer =
    element cc:visualizer {
        attribute name { "silent" | "plain" | "detail" },
        attribute * - name { text }*,
        empty
    }

cc.xmlSchema =
    element cc:xml-schema {
        attribute href { xsd:anyURI },
        empty
    }

cc.xqueryProcessor =
    element cc:xquery-processor {
        attribute name { xsd:anyURI },
        attribute * - name { text }*,
        empty
    }

cc.catalog =
    element cc:catalog {
        attribute href { xsd:anyURI },
        empty
    }

cc.pipeline =
    element cc:pipeline {
        attribute href { xsd:anyURI },
        attribute step { xsd:NCName }?,
        attribute temporary-files { xsd:anyURI }?,
        (cc.input | cc.inputMultiplex
         | cc.output | cc.outputMultiplex | cc.manifest
         | cc.option)*
    }

cc.input =
    element cc:input {
        attribute port { xsd:NCName },
        attribute href { xsd:anyURI }?,
        attribute content-type { text }?,
        attribute encoding { "base64" }?,
        (text | any-name)?
    }

cc.inputMultiplex =
    element cc:input-multiplex {
        attribute href { xsd:anyURI }?,
        empty
    }

cc.output =
    element cc:output {
        attribute port { xsd:NCName },
        attribute content-type { "multipart/mixed" }?,
        attribute filespec { text },
        empty
    }

cc.outputMultiplex =
    element cc:output-multiplex {
        attribute content-type { "multipart/mixed" }?,
        attribute href { text },
        empty
    }

cc.manifest =
    element cc:manifest {
        attribute href { text },
        empty
    }

cc.option =
    element cc:option {
        attribute name { xsd:QName },
        # Value and select are mutually exclusive, but the documentation
        # tableaux doesn't handle that case very well.
        attribute value { text }?,
        attribute select { text }?,
        attribute content-type { text }?,
        attribute encoding { "base64" }?,
        (text | any-name)?
    }

cc.namespace =
    element cc:namespace {
        attribute prefix { xsd:NCName },
        attribute uri { text },
        empty
    }

any-other-name =
    element * - cc:* {
        attribute * { text }*,
        empty
    }

any-name =
    element * {
        attribute * { text }*,
        empty
    }
